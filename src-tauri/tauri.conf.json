{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TAUT",
  "version": "1.0.0-alpha.3",
  "identifier": "app.taut.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TAUT",
        "dragDropEnabled": false,
        "width": 1360,
        "height": 850,
        "minWidth": 840,
        "minHeight": 550,
        "backgroundColor": "#11161b"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://graph.microsoft.com; img-src 'self' data:; style-src 'self' 'unsafe-inline';"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": []
  }
}
